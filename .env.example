APP_NAME=Agentic RAG
APP_ENV=development
APP_DEBUG=true

JWT_SECRET_KEY=super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_URL=sqlite:///./data/sqlite/app.db

MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_PREFIX=rag_

# Embedding 配置
EMBEDDING_USE_LOCAL=false
EMBEDDING_API_KEY=your-api-key
EMBEDDING_API_BASE=https://ark.cn-beijing.volces.com/api/v3
EMBEDDING_MODEL=doubao-embedding-v1
EMBEDDING_DIMENSION=1024

# 本地模型（EMBEDDING_USE_LOCAL=true 时使用）
SENTENCE_TRANSFORMER_MODEL=BAAI/bge-m3
HF_ENDPOINT=https://hf-mirror.com

# 对话模型配置
CHAT_PROVIDER=doubao
DOUBAO_API_KEY=your-doubao-api-key
DOUBAO_CHAT_MODEL=your-endpoint-id
OPENAI_CHAT_MODEL=gpt-4

# RAG 配置
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_TOP_N=5

HYBRID_SEARCH_ENABLED=true
DENSE_WEIGHT=0.7
SPARSE_WEIGHT=0.3

CHUNK_LARGE_SIZE=2000
CHUNK_MEDIUM_SIZE=500
CHUNK_SMALL_SIZE=150
CHUNK_OVERLAP=50

# 文件上传
MAX_UPLOAD_SIZE=52428800
ALLOWED_EXTENSIONS=pdf,txt,docx,md
UPLOAD_DIR=./data/uploads
SQLITE_DIR=./data/sqlite

# 管理员账号
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=admin123
FIRST_ADMIN_EMAIL=admin@example.com

# OpenTelemetry 配置
OTEL_ENABLED=true
OTEL_SERVICE_NAME=first-rag-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SAMPLING_RATE=1.0

# Chunk 生命周期配置（可选，不设置则使用默认值）
# CONFLICT_DETECTION_HIGH_CONFIDENCE=0.85
# CONFLICT_DETECTION_LOW_CONFIDENCE=0.5
# COLD_KNOWLEDGE_TIMEOUT_DAYS=90
# COLD_KNOWLEDGE_LOW_FREQ_THRESHOLD=2
# COLD_KNOWLEDGE_LOW_FREQ_MIN_DAYS=30
# COLD_KNOWLEDGE_LOW_QUALITY_SCORE=0.3
# COLD_KNOWLEDGE_LOW_QUALITY_MIN_HITS=5
# COLD_KNOWLEDGE_ARCHIVE_RETENTION_DAYS=90
# COLD_KNOWLEDGE_SWEEP_CRON=0 3 * * *
# HARD_DELETE_SWEEP_CRON=0 4 * * *
